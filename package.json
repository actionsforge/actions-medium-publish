{
  "name": "actions-medium-publish",
  "version": "1.0.0",
  "description": "Publish markdown articles to Medium from your GitHub repository using the Medium API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build"
  },
  "keywords": ["medium", "github-actions", "markdown", "publishing"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.15.24",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@actions/io": "^1.1.3",
    "axios": "^1.6.7",
    "gray-matter": "^4.0.3"
  }
